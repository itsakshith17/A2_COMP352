import java.io.File;
import java.io.FileNotFoundException;
import java.util.Scanner;

public class WildcardParentheses {
    // The input ends in '$' and uses only the characters in the assignment.
    public static boolean isValid(String input) {
        int wildcardCount = 0;
        for (int i = 0; input.charAt(i) != '$'; i++) {
            if (input.charAt(i) == '*') {
                wildcardCount++;
            }
        }

        // 0 skips a wildcard, 1 treats it as '(', and 2 treats it as ')'.
        int[] choices = new int[wildcardCount];
        ExpandableStack stack = new ExpandableStack();

        do {
            while (!stack.isEmpty()) {
                stack.pop();
            }
            if (isBalanced(input, choices, stack)) {
                return true;
            }
        } while (advanceChoices(choices));

        return false;
    }

    private static boolean isBalanced(String input, int[] choices,
                                      ExpandableStack stack) {
        int wildcardIndex = 0;

        for (int i = 0; input.charAt(i) != '$'; i++) {
            char symbol = input.charAt(i);
            if (symbol == '*') {
                int choice = choices[wildcardIndex];
                wildcardIndex++;
                if (choice == 0) {
                    continue;
                }
                symbol = (choice == 1) ? '(' : ')';
            }

            if (symbol == '(') {
                stack.push(symbol);
            } else {
                if (stack.isEmpty()) {
                    return false;
                }
                stack.pop();
            }
        }

        return stack.isEmpty();
    }

    private static boolean advanceChoices(int[] choices) {
        for (int i = choices.length - 1; i >= 0; i--) {
            if (choices[i] < 2) {
                choices[i]++;
                return true;
            }
            choices[i] = 0;
        }
        return false;
    }

    public static void main(String[] args) throws FileNotFoundException {
        String fileName = "test-cases.txt";
        if (args.length > 0) {
            fileName = args[0];
        }

        Scanner fileInput = new Scanner(new File(fileName));
        while (fileInput.hasNext()) {
            String input = fileInput.next();
            String result = isValid(input) ? "Valid" : "Invalid";
            System.out.println(input + " - " + result);
        }
        fileInput.close();
    }
}
